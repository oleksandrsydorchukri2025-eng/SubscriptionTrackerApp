<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.subscriptiontracker.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.subscriptiontracker.RegisterFragment"
        android:label="RegisterFragment" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.subscriptiontracker.DashboardFragment"
        android:label="DashboardFragment" >
        <action
            android:id="@+id/action_dashboardFragment_to_addSubscriptionFragment"
            app:destination="@id/addSubscriptionFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_subscriptionDetailsFragment"
            app:destination="@id/subscriptionDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addSubscriptionFragment"
        android:name="com.example.subscriptiontracker.AddSubscriptionFragment"
        android:label="AddSubscriptionFragment" />

    <fragment
        android:id="@+id/subscriptionDetailsFragment"
        android:name="com.example.subscriptiontracker.SubscriptionDetailsFragment"
        android:label="SubscriptionDetailsFragment" />
    <action
        android:id="@+id/action_dashboardFragment_to_loginFragment"
        app:destination="@id/loginFragment" />

</navigation>